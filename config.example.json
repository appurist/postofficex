{
  "server": {
    "smtp": {
      "host": "0.0.0.0",
      "port": 25,
      "hostname": "mail.example.test",
      "allowPlaintext": true,
      "enableStartTls": true
    },
    "submission": {
      "host": "0.0.0.0",
      "port": 587,
      "tlsPort": 465,
      "allowPlaintext": false,
      "enableStartTls": false,
      "enableTls": true
    },
    "pop3": {
      "host": "0.0.0.0",
      "port": 110,
      "tlsPort": 995,
      "allowPlaintext": false,
      "enableStartTls": false,
      "enableTls": true
    },
    "imap": {
      "host": "0.0.0.0",
      "port": 143,
      "tlsPort": 993,
      "allowPlaintext": false,
      "enableStartTls": false,
      "enableTls": true
    }
  },
  "outbound": {
    "greetingHostname": "mail.example.test",
    "connectTimeoutMs": 30000,
    "preferStartTls": true
  },
  "tls": {
    "certFile": "./certs/server.crt",
    "keyFile": "./certs/server.key"
  },
  "limits": {
    "maxMessageBytes": 10485760,
    "maxRecipientsPerMessage": 64,
    "maxMailboxBytes": 52428800,
    "socketTimeoutMs": 300000,
    "maxInvalidAuthAttempts": 10
  },
  "storage": {
    "rootDir": "./data"
  },
  "admin": {
    "host": "0.0.0.0",
    "port": 80,
    "enableTls": false,
    "logRequests": false,
    "password": "",
    "passwordHash": ""
  },
  "domains": [
    "example.test"
  ],
  "users": []
}
