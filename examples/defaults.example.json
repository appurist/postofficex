{
  "server": {
    "smtp": {
      "host": "::",
      "port": 25,
      "allowPlaintext": false,
      "enableStartTls": false
    },
    "submission": {
      "host": "::",
      "port": 587,
      "tlsPort": 465,
      "allowPlaintext": false,
      "enableStartTls": false,
      "enableTls": true
    },
    "pop3": {
      "host": "::",
      "port": 110,
      "tlsPort": 995,
      "allowPlaintext": false,
      "enableStartTls": false,
      "enableTls": true
    },
    "imap": {
      "host": "::",
      "port": 143,
      "tlsPort": 993,
      "allowPlaintext": false,
      "enableStartTls": false,
      "enableTls": true
    }
  },
  "outbound": {
    "connectTimeoutMs": 30000,
    "preferStartTls": true
  },
  "tls": {
    "certFile": "./certs/server.crt",
    "keyFile": "./certs/server.key"
  },
  "limits": {
    "maxMessageBytes": 10485760,
    "maxRecipientsPerMessage": 64,
    "maxMailboxBytes": 52428800,
    "socketTimeoutMs": 300000,
    "maxInvalidAuthAttempts": 10
  },
  "storage": {
    "rootDir": "."
  },
  "admin": {
    "host": "::",
    "port": 443,
    "enableTls": true,
    "logRequests": true
  }
}
